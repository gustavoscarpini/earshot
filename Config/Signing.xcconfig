// Earshot — shared code signing configuration.
//
// Do not edit this file for your local setup. Instead copy
// Config/Local.xcconfig.example to Config/Local.xcconfig and set your values
// there; that file is gitignored and included by the line below.

// Bundle identifier prefix used by the app and the test bundle.
BUNDLE_ID_PREFIX = com.gustavoscarpini

// Your Apple Developer team ID. Leave empty to ad-hoc sign ("Sign to Run
// Locally"). Free Personal Team IDs work.
DEVELOPMENT_TEAM =

CODE_SIGN_STYLE = Automatic

// "-" means ad-hoc signing, used when no team is set. With a team, set
// CODE_SIGN_IDENTITY = Apple Development in Local.xcconfig.
CODE_SIGN_IDENTITY = -

// Optional local overrides (gitignored).
#include? "Local.xcconfig"
